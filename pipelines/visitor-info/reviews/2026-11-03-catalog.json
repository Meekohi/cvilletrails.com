  "research_notes": {
    "washington-park": [
      "Facility page says 6 a.m.–9 p.m.; City park-regulations page says 6 a.m.–10 p.m. Conflict is shown rather than silently resolved."
    ],
    "uva": [
      "No trail-specific operating hours or sufficiently clear current pet policy found on the reviewed UVA pages or O-Hill map. Those fields are omitted; campus recreation-field rules are not generalized to woodland trails."
    ],
    "montpelier": [
      "Older third-party and local-government guides describe free access. The current operator page explicitly requires tickets or membership; current operator policy takes precedence."
    ],
    "wintergreen": [
      "The Nature Foundation page footer lists office/visitor-center hours, not trail hours; omitted. No current explicit trail cycling policy found; omitted. WPOA distinguishes general community dog control from trail leash guidance. Resort ski-slope pet policies are not applied to all hiking trails."
    ],
    "ragged-mountain": [
      "The visiting page does not state a current cycling/running rule; do not turn the general City guide’s exception wording into a specific ban without further evidence. Construction status is attributed to the City and should be rechecked.",
      "Retained the existing reservoir-wide context bounds: municipal park polygons exclude part of the lake view. The smaller Heyward area takes priority where they overlap."
    ],
    "monticello": [
      "Older trail PDFs excluded dogs from boardwalks. Current operator website explicitly permits leashed dogs on boardwalks and supersedes that older wording."
    ]
  },
